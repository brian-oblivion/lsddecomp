{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-sha1-edits.py" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-asm-edits.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-sha1-edits.py" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-raw-make.py" }
        ]
      }
    ]
  }
}
