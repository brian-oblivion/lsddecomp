diff --git a/maspsx.py b/maspsx.py
index 4e3a382..a6a24e9 100644
--- a/maspsx.py
+++ b/maspsx.py
@@ -59,6 +59,9 @@ def main() -> None:
     parser.add_argument("--macro-inc", action="store_true")
     parser.add_argument("--dont-expand-li", action="store_true")
     parser.add_argument("--addiu-at", action="store_true")
+    parser.add_argument("--gp-symbols", type=str, default=None)
+    parser.add_argument("--no-nop-mflo-mfhi", action="store_true")
+    parser.add_argument("--nop-at-expansion", action="store_true")
     parser.add_argument("--force-stdin", action="store_true")
     parser.add_argument("--passthrough", action="store_true")
     parser.add_argument("--use-comm-section", action="store_true")
@@ -129,6 +132,19 @@ def main() -> None:
 
         filtered_as_args.append(arg)
 
+    # Symbols the retail link placed in .sdata/.sbss and therefore reaches
+    # gp-relatively. With -G0 cc1 emits no size hints and the project's data
+    # is defined in splat asm, not C, so maspsx's own sdata_entries table
+    # (same-file .sdata/.comm only) can never learn them. Seed it explicitly.
+    # See docs/research/gp-relative-blocker.md.
+    gp_symbols: set = set()
+    if args.gp_symbols:
+        with open(args.gp_symbols) as f:
+            for l in f:
+                l = l.split("#", 1)[0].strip()
+                if l:
+                    gp_symbols.add(l)
+
     if args.passthrough:
         processor = PassthroughProcessor(in_lines)
 
@@ -146,10 +162,26 @@ def main() -> None:
         # docs/research/addiu-at-blocker.md, "Options", option 1.
         if args.addiu_at:
             version_config.addiu_at = True
+        # Same decoupling for nop_mflo_mfhi: config_for_aspsx_version turns it
+        # OFF only below 2.30. Retail never takes the hazard nops between an
+        # mflo/mfhi and a following mult/div; cc1 emits them as commented
+        # "#nop" hints and this flag leaves them commented. Byte-exact across
+        # the whole image. See docs/research/addiu-at-blocker.md.
+        if args.no_nop_mflo_mfhi:
+            version_config.nop_mflo_mfhi = False
+        # Fourth decoupling, same shape (lsddecomp2 round 62/63). ASPSX 2.34
+        # decides the load-delay hazard BEFORE expanding a store-to-symbol
+        # macro, so `lbu $2,0($4)` followed by `sb $2,G` gets a nop even though
+        # the expansion interposes `lui $at`. Retail: 40 such sites with the
+        # nop, 0 without. config_for_aspsx_version turns this on only below
+        # 2.30; this flag turns it on alone.
+        if args.nop_at_expansion:
+            version_config.nop_at_expansion = True
 
         processor = MaspsxProcessor(
             in_lines,
             sdata_limit=sdata_limit,
+            gp_symbols=gp_symbols,
             expand_div=args.expand_div,
             expand_li=version_config.expand_li,
             nop_at_expansion=version_config.nop_at_expansion,
