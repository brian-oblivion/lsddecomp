/* GENERATED by `tools/psyq_sdk.py ldfrag` from config/psyq-objects.txt and
 * the objects in lib/ -- do not edit; `psyq_sdk.py check` verifies it is current.
 *
 * Sony's linker allocated uninitialised library variables one by one across
 * objects, so a Psy-Q object's .bss is not contiguous in retail. Each NOBITS
 * section is placed where its section-relative references demand, and every
 * variable is pinned to its retail address (a script assignment overrides the
 * object's own definition). NOLOAD: none of this is in the executable image. */
SECTIONS {
    .psyq_bss.libetc_pad_bss 0x8008B3C8 (NOLOAD) : SUBALIGN(2) { build/lib/libetc/pad.o(.bss) }   /* 0x8 bytes; section-relative refs */
}
PadIdentifier = 0x8008E984;   /* libetc/pad */
/* externals the linked objects reference and nothing in the link defines yet;
 * each is the address retail's own code calls. Once the defining object is
 * linked the pin still holds (a script assignment wins) and must agree. */
printf = 0x80012C20;
putchar = 0x800133E0;
ResetCallback = 0x80024D10;
InterruptCallback = 0x80024D40;
ChangeClearPAD = 0x80025434;
ChangeClearRCnt = 0x80025454;
